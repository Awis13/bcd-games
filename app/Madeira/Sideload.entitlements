<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What the unsigned IPA asks a sideloader for, through an ad-hoc signature
	     (tools/ota-variants.py fakesign). SideStore/AltStore sign with the
	     profile's entitlements filtered by the app's own, so an entitlement the
	     IPA does not carry is dropped even when GetMoreRam has enabled it on the
	     App ID. Only what a free or paid sideloading profile can grant:
	     Madeira.entitlements' increased-debugging-memory-limit (development
	     profiles only) and allow-jit (macOS only) stay out. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
